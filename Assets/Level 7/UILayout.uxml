<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="tint" enabled="true" style="flex-grow: 1; position: relative; height: 1000%; width: 1000%; background-color: rgba(2, 2, 2, 0.6); left: -10%; top: -100%; flex-direction: row; align-self: flex-start; bottom: 0%; align-items: auto; max-height: none; min-height: 200%;" />
    <ui:Button text="Restart" name="Restart" style="height: 41px; width: 152px; align-items: center; align-self: center; align-content: auto; top: -170%; position: relative; background-color: rgb(156, 205, 124); border-top-color: rgb(137, 180, 109); border-left-color: rgb(137, 180, 109); border-right-color: rgb(137, 180, 109); border-bottom-color: rgb(137, 180, 109); border-top-right-radius: 10px; border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;" />
    <ui:Label text="Time:" name="Timer" tabindex="2" style="background-color: rgba(76, 76, 76, 0); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); color: rgb(255, 251, 251); top: -200%;" />
    <ui:Label text="You Won!" name="winText" tabindex="2" style="align-self: center; color: rgb(0, 0, 0); -unity-font-style: bold; border-left-color: rgb(165, 217, 132); border-right-color: rgb(165, 217, 132); border-top-color: rgb(165, 217, 132); border-bottom-color: rgb(165, 217, 132); background-color: rgb(169, 221, 135); border-left-width: 10px; border-right-width: 10px; border-top-width: 10px; border-bottom-width: 10px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-left-radius: 5px; top: -200%; position: relative; align-items: center; align-content: center; left: 0%; justify-content: center; -unity-text-align: upper-center;" />
    <ui:Button text="Done" name="Done" tabindex="2" style="height: 41px; width: 152px; align-items: center; align-self: center; align-content: auto; top: -160%; position: relative; background-color: rgb(171, 224, 137); border-top-color: rgb(137, 180, 109); border-left-color: rgb(137, 180, 109); border-right-color: rgb(137, 180, 109); border-bottom-color: rgb(137, 180, 109); border-top-right-radius: 10px; border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; text-overflow: clip;" />
</ui:UXML>
