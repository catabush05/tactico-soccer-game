<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="tint" enabled="true" style="flex-grow: 1; position: relative; height: 100%; width: 500%; background-color: rgba(2, 2, 2, 0.6); left: 0%; top: 0%; flex-direction: row; align-self: center;" />
    <ui:Button text="Restart" name="Restart" style="height: 41px; width: 152px; align-items: center; align-self: center; align-content: auto; top: 40%; position: relative; background-color: rgb(171, 224, 137); border-top-color: rgb(137, 180, 109); border-left-color: rgb(137, 180, 109); border-right-color: rgb(137, 180, 109); border-bottom-color: rgb(137, 180, 109); border-top-right-radius: 10px; border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;" />
    <ui:Label text="Time:" name="Timer" style="background-color: rgba(76, 76, 76, 0); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); color: rgb(255, 251, 251);" />
    <ui:Label text="You Won!" name="winText" style="align-self: center; color: rgb(0, 0, 0); -unity-font-style: bold; border-left-color: rgb(171, 224, 137); border-right-color: rgb(171, 224, 137); border-top-color: rgb(171, 224, 137); border-bottom-color: rgb(171, 224, 137); background-color: rgb(169, 223, 136); border-left-width: 10px; border-right-width: 10px; border-top-width: 10px; border-bottom-width: 10px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-left-radius: 5px; top: -10%; position: relative; align-items: center; align-content: center; left: 0%; justify-content: center; -unity-text-align: upper-center;" />
    <ui:Button text="Done" name="Done" style="height: 41px; width: 152px; align-items: center; align-self: center; align-content: auto; top: 40%; position: relative; background-color: rgb(136, 178, 109); border-top-color: rgb(137, 180, 109); border-left-color: rgb(137, 180, 109); border-right-color: rgb(137, 180, 109); border-bottom-color: rgb(137, 180, 109); border-top-right-radius: 10px; border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; text-overflow: clip;" />
</ui:UXML>
